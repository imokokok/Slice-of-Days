; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Solmere · 五日旅程"
config/use_custom_user_dir=true
config/custom_user_dir_name="Solmere_Playable_Meta"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[audio]

driver/enable_input=true

[autoload]

PaperLanguage="*res://scripts/ui/paper_language.gd"
LocalizationSystem="*res://scripts/core/localization_system.gd"
CharacterSystem="*res://scripts/core/character_system.gd"
GameEvents="*res://scripts/core/game_events.gd"
GameState="*res://scripts/core/game_state.gd"
WorldAtmosphere="*res://scripts/ui/world_atmosphere.gd"
ScheduleSystem="*res://scripts/core/schedule_system.gd"
ResidentProfileSystem="*res://scripts/core/resident_profile_system.gd"
TravelSystem="*res://scripts/core/travel_system.gd"
WorldGraph="*res://scripts/core/world_graph.gd"
KnowledgeSystem="*res://scripts/core/knowledge_system.gd"
EchoSystem="*res://scripts/core/echo_system.gd"
DialogueSystem="*res://scripts/core/dialogue_system.gd"
RelationshipSystem="*res://scripts/core/relationship_system.gd"
EventSystem="*res://scripts/core/event_system.gd"
ChapterSystem="*res://scripts/core/chapter_system.gd"
GameplayModuleSystem="*res://scripts/core/gameplay_module_system.gd"
SaveManager="*res://scripts/core/save_manager.gd"
SettingsSystem="*res://scripts/core/settings_system.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
WorldSound="*res://scripts/town_sound/audio/WorldSound.gd"
SoundSettings="*res://scripts/town_sound/audio/SoundSettings.gd"
ObservatoryState="*res://extensions/observatory/scripts/game_state.gd"
ObservatoryAudio="*res://extensions/observatory/scripts/audio_manager.gd"
MetaExperience="*res://scripts/meta/meta_experience.gd"
ResidencySystem="*res://scripts/residency/residency_system.gd"
EconomySystem="*res://scripts/core/economy_system.gd"
FilmSystem="*res://scripts/photography/film_system.gd"
GuidanceSystem="*res://scripts/core/guidance_system.gd"
CoreLoopSystem="*res://scripts/core/core_loop_system.gd"
UIStateSystem="*res://scripts/core/ui_state_system.gd"
HouseholdSystem="*res://scripts/core/household_system.gd"

LifeSystem="*res://scripts/core/life_system.gd"
PeoplePuzzleSystem="*res://scripts/core/people_puzzle_system.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://art/ui/solmere_ui.tres"
theme/default_font_multichannel_signed_distance_field=true

[internationalization]

locale/fallback="zh_CN"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.973, 0.929, 0.851, 1)
